# ==================== SERVIDOR ====================
PORT=5000
NODE_ENV=development

# ==================== AUTENTICAÇÃO JWT ====================
# Gere uma chave nova com: openssl rand -hex 32
JWT_SECRET=troque-esta-chave-antes-de-subir-para-producao
JWT_EXPIRY=24h

# ==================== CORS ====================
# Origem do frontend (Vite roda na 3000)
CORS_ORIGIN=http://localhost:3000

# ==================== UPLOAD ====================
MAX_UPLOAD_SIZE=52428800

# ==================== DATA ====================
DATA_DIR=./data

# ==================== ANÁLISES SALVAS (Supabase, opcional) ====================
# Sem estas variáveis, as análises ficam em memória e somem ao reiniciar.
# Use a chave service_role (Project Settings > API). Ela fica SÓ no backend:
# nunca a coloque no frontend, em VITE_* nem no repositório.
# Crie as tabelas e o bucket "lotes" uma vez com backend/supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ==================== AUTH0 (Opcional) ====================
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
